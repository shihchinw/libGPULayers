{
    "layer": "VK_LAYER_LGL_gpu_support",
    "feature": {
        "robustBufferAccess_enable": false,
        "robustBufferAccess_disable": false
    },
    "serialize": {
        "all": false,
        "none": false,
        "commandstream": {
            "compute": {
                "pre": false,
                "post": false
            },
            "renderpass": {
                "pre": false,
                "post": false
            },
            "asbuild": {
                "pre": false,
                "post": false
            },
            "tracerays": {
                "pre": false,
                "post": false
            },
            "transfer": {
                "pre": false,
                "post": false
            }
        },
        "queue": false,
        "queue_wait_idle": false
    },
    "shader": {
        "disable_cache": false,
        "disable_relaxed_precision": false,
        "enable_spirv_fuzz": false
    },
    "shader_dump": {
        "enable": true,
        "output_path": "/data/local/tmp/lgl-shader-dump",
        "mode": "compact",
        "capture_statistics": true,
        "capture_debug_utils": true,
        "usage_capture": "frame_summary",
        "frame_start": 0,
        "frame_count": 300
    },
    "framebuffer": {
        "disable_compression": false,
        "force_default_compression": false,
        "force_fixed_rate_compression": 0
    }
}
